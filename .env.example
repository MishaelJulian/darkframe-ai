# AI Storytelling Configuration (.env.example)
# Copy to .env for local overrides. Never commit .env!

# Environment & Paths
APP_ENV=development
DATA_DIR=data
OUTPUT_DIR=output
PROMPTS_IO_DIR=prompts_io
DB_PATH=data/storytelling.db
LOG_LEVEL=INFO

# Cost, Budget & Safety Guards (Non-Negotiable Defaults)
ALLOW_PAID_APIS=false
ALLOW_GEMINI_API=false
PUBLISHING_ENABLED=false
MAX_CONCURRENT_GPU_JOBS=1
MONTHLY_BUDGET_INR=0.0
PER_JOB_BUDGET_INR=0.0

# LLM Provider Selection: file | gemini | ollama
LLM_PROVIDER=file
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Local ComfyUI Settings (RTX 4050 6 GB VRAM)
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8188
COMFYUI_FALLBACK_PORT=8000
COMFYUI_SHARED_MODELS_DIR=C:/Users/misha/AppData/Local/Comfy-Desktop/ComfyUI-Shared/models
COMFYUI_DEFAULT_WIDTH=512
COMFYUI_DEFAULT_HEIGHT=768
COMFYUI_STEPS=24
COMFYUI_BATCH_SIZE=1

# Local Voiceover & FFmpeg Settings
TTS_ENGINE=piper
PIPER_EXECUTABLE=piper
PIPER_MODEL_PATH=
FFMPEG_EXECUTABLE=ffmpeg
FFPROBE_EXECUTABLE=ffprobe
